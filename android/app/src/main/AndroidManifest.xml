<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Nova Radar (socket scanning) + the sing-box core both need network. -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE"/>
    <!-- requestNetwork() for the VPN's underlying-network monitor: on Android 9+
         registerDefaultNetworkCallback returns our own tun interface, so the
         core must REQUEST the physical uplink to route `direct` outbounds. -->
    <uses-permission android:name="android.permission.CHANGE_NETWORK_STATE"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
    <!-- targetSdk 35: the VpnService runs as a "systemExempted" foreground
         service, which Android 14+ gates behind this permission. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SYSTEM_EXEMPTED"/>
    <!-- Proxy mode runs the same core with no VPN interface, so the
         systemExempted type above is refused: Android grants that one off the
         `activate_vpn` app op, which only exists once a VPN is actually
         established. A local proxy is a specialUse service. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE"/>
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>

    <application
        android:label="Nova Client"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
            <!-- Deep link used by the OAuth "Return to Nova" button on the
                 sign-in callback page. singleTop + this filter brings the
                 running app back to the front. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="novaclient"/>
                <data android:scheme="nova"/>
            </intent-filter>
        </activity>

        <!-- The sing-box tunnel host. BIND_VPN_SERVICE + the VpnService action
             are required for Android to treat this as a VPN provider. -->
        <service
            android:name=".NovaVpnService"
            android:permission="android.permission.BIND_VPN_SERVICE"
            android:exported="false"
            android:foregroundServiceType="systemExempted|specialUse">
            <intent-filter>
                <action android:name="android.net.VpnService"/>
            </intent-filter>
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Runs the local SOCKS5/HTTP proxy in proxy mode,
                    where the user has chosen not to tunnel the whole device and
                    only the apps they point at the port go through Nova."/>
        </service>

        <!-- Home-screen status widget. Reflects the tunnel state and opens the
             app when tapped. -->
        <receiver
            android:name=".NovaWidgetProvider"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE"/>
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/nova_widget_info"/>
        </receiver>

        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
