<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Fallback subtitle for the ongoing notification when no profile name is
         passed. The launcher label stays in the manifest. -->
    <string name="app_name">Nova</string>

    <!-- Ongoing VPN status notification. -->
    <string name="vpn_channel_name">VPN status</string>
    <string name="vpn_channel_desc">Shows whether Nova is connected and lets you disconnect.</string>
    <string name="vpn_state_connecting">Connecting…</string>
    <string name="vpn_state_connected">Connected</string>
    <!-- Proxy mode: no device-wide tunnel, so the notification says where the
         proxy actually is instead of claiming the phone is connected. -->
    <string name="vpn_state_proxy">Proxy on 127.0.0.1:%1$d</string>
    <string name="vpn_action_disconnect">Disconnect</string>
</resources>
