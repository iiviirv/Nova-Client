<?xml version="1.0" encoding="utf-8"?>
<!-- Native cold-start screen. Pinned dark (the app is always dark) so there is
     no white flash before Flutter renders, with the Nova mark centred. The
     bilingual tagline lives on the Flutter splash that follows. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#0B0D12" />
        </shape>
    </item>
    <item>
        <bitmap
            android:gravity="center"
            android:src="@mipmap/ic_launcher" />
    </item>
</layer-list>
