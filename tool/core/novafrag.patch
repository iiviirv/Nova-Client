+// NovaFragmentStage is one stage of the Xray-style finalmask fragment carried
+// in the `nova_fragment` outbound TLS option (see transport/internet/novafrag).
+type NovaFragmentStage struct {
+	Packets  string   `json:"packets,omitempty"`
+	Lengths  []string `json:"lengths,omitempty"`
+	Delays   []string `json:"delays,omitempty"`
+	MaxSplit string   `json:"maxSplit,omitempty"`
