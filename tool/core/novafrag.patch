+// buildNovaFragment converts the parsed nova_fragment option stages into the
+// novafrag stages the connection wrapper takes.
+func buildNovaFragment(stages []option.NovaFragmentStage) []novafrag.Stage {
+	if len(stages) == 0 {
+		return nil
+	}
+	out := make([]novafrag.Stage, 0, len(stages))
+	for _, s := range stages {
+		out = append(out, novafrag.NewStage(s.Packets, s.Lengths, s.Delays, s.MaxSplit))
+	}
+	return out
+}
