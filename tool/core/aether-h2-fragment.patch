+#[cfg(test)]
+mod nova_wire_tests {
+    use super::*;
+    use tokio::io::AsyncWriteExt;
+    #[derive(Default)]
+    struct Recorder(Vec<Vec<u8>>);
+    impl AsyncWrite for Recorder {
+        fn poll_write(mut self: Pin<&mut Self>, _: &mut Context<'_>, b: &[u8]) -> Poll<io::Result<usize>> {
+            self.0.push(b.to_vec()); Poll::Ready(Ok(b.len()))
+        }
+        fn poll_flush(self: Pin<&mut Self>, _: &mut Context<'_>) -> Poll<io::Result<()>> { Poll::Ready(Ok(())) }
+        fn poll_shutdown(self: Pin<&mut Self>, _: &mut Context<'_>) -> Poll<io::Result<()>> { Poll::Ready(Ok(())) }
+    }
+    #[tokio::test]
+    async fn nova_custom_fragment_size_and_delay_affect_writes() {
+        let cfg = FragmentConfig { enabled:true, size_min:4, size_max:4, delay_min_ms:20, delay_max_ms:20, sni_split:false };
+        let mut stream = FragmentingStream::new(Recorder::default(),cfg);
+        let start = std::time::Instant::now();
+        stream.write_all(b"abcdefghijkl").await.unwrap();
+        assert_eq!(stream.inner.0,vec![b"abcd".to_vec(),b"efgh".to_vec(),b"ijkl".to_vec()]);
+        assert!(start.elapsed() >= Duration::from_millis(40));
+    }
+}
