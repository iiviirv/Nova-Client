+// Ranges are validated before launching a job, not silently replaced.
+fn fragment_options(enabled: bool, size: Option<&str>, delay: Option<&str>) -> std::result::Result<crate::fragment::FragmentConfig, String> {
+    fn range(raw: &str, min: u64, max: u64) -> std::result::Result<(u64, u64), String> {
+        let parts: Vec<&str> = raw.split('-').collect();
+        if parts.is_empty() || parts.len() > 2 { return Err("invalid fragment range".into()); }
+        let lo = parts[0].trim().parse::<u64>().map_err(|_| "invalid fragment range")?;
+        let hi = parts.last().unwrap().trim().parse::<u64>().map_err(|_| "invalid fragment range")?;
+        if lo < min || hi > max || lo > hi { return Err("fragment range out of bounds".into()); }
+        Ok((lo, hi))
+    }
+    let (size_min, size_max) = range(size.unwrap_or("16-32"), 1, 16384)?;
+    let (delay_min_ms, delay_max_ms) = range(delay.unwrap_or("2-10"), 0, 1000)?;
+    // sni_split is upstream's targeted split, new in v2.3.0. Left off here so
+    // the rebase changes nothing: it is what upstream defaults to without the
+    // env var, and what Nova shipped before the field existed.
+    Ok(crate::fragment::FragmentConfig { enabled, size_min: size_min as usize, size_max: size_max as usize, delay_min_ms, delay_max_ms, sni_split: false })
+}
+
+#[cfg(test)]
+mod nova_fragment_tests {
+    use super::*;
+
+    /// The MASQUE name is process-wide, like the transport and fragment
+    /// settings the core already reads from the environment, so two tests
+    /// building a spec at the same time overwrite each other's. Every test
+    /// that touches it takes this first. Found the honest way: the assertion
+    /// below failed under the default parallel runner and passed under
+    /// --test-threads=1.
+    static SNI_LOCK: std::sync::Mutex<()> = std::sync::Mutex::new(());
+
+    #[test]
+    fn nova_h2_options_reach_tunnel_spec_and_do_not_change_h3() {
+        let _guard = SNI_LOCK.lock().unwrap_or_else(|e| e.into_inner());
+        let payload: TunnelPayload = serde_json::from_value(json!({
+            "peer":"127.0.0.1:443", "transport":"h2", "fragment":true,
+            "fragment_size":"17-23", "fragment_delay":"3-7"
+        })).unwrap();
+        let spec = tunnel_spec_of(&payload).unwrap();
+        assert!(spec.http2 && spec.fragment.enabled);
+        assert_eq!((spec.fragment.size_min,spec.fragment.size_max),(17,23));
+        assert_eq!((spec.fragment.delay_min_ms,spec.fragment.delay_max_ms),(3,7));
+        let h3: TunnelPayload = serde_json::from_value(json!({"peer":"127.0.0.1:443", "transport":"h3", "fragment":true})).unwrap();
+        let other = tunnel_spec_of(&h3).unwrap();
+        assert!(!other.http2 && !other.fragment.enabled);
+        assert!(spec.http2 && spec.fragment.enabled);
+    }
+    /// The whole point of the field: the name actually reaches the handshake.
+    /// Asserting on the payload parsing alone would pass even if nothing read
+    /// it, which is the shape of mistake this core has already shipped once.
+    #[test]
+    fn nova_sni_override_reaches_the_handshake_and_blank_restores_the_default() {
+        let _guard = SNI_LOCK.lock().unwrap_or_else(|e| e.into_inner());
+        let payload: TunnelPayload = serde_json::from_value(json!({
+            "peer":"127.0.0.1:443", "transport":"h2", "sni":"www.cloudflare.com"
+        })).unwrap();
+        tunnel_spec_of(&payload).unwrap();
+        assert_eq!(crate::consts::connect_sni(), "www.cloudflare.com");
+
+        // Blank is "use the built-in name", not "use an empty name". An empty
+        // SNI makes Cloudflare serve a self-signed cert for an unrecognised
+        // name, which is a different failure and a confusing one.
+        for blank in [json!(""), json!("   "), json!(null)] {
+            let p: TunnelPayload = serde_json::from_value(json!({
+                "peer":"127.0.0.1:443", "transport":"h2", "sni": blank
+            })).unwrap();
+            tunnel_spec_of(&p).unwrap();
+            assert_eq!(crate::consts::connect_sni(), crate::consts::CONNECT_SNI);
+        }
+
+        // A job that says nothing about the name must not inherit the last
+        // one, or a fallback attempt would silently reuse the name that just
+        // failed.
+        let prev: TunnelPayload = serde_json::from_value(json!({
+            "peer":"127.0.0.1:443", "transport":"h2", "sni":"example.invalid"
+        })).unwrap();
+        tunnel_spec_of(&prev).unwrap();
+        let quiet: TunnelPayload =
+            serde_json::from_value(json!({"peer":"127.0.0.1:443"})).unwrap();
+        tunnel_spec_of(&quiet).unwrap();
+        assert_eq!(crate::consts::connect_sni(), crate::consts::CONNECT_SNI);
+    }
+
+    #[test]
+    fn nova_fragment_ranges_reject_invalid_values_and_keep_defaults() {
+        let c = fragment_options(true,None,None).unwrap();
+        assert_eq!((c.size_min,c.size_max,c.delay_min_ms,c.delay_max_ms),(16,32,2,10));
+        for v in ["0","32-16","1-16385","junk","1-2-3"] {
+            assert!(fragment_options(true,Some(v),None).is_err());
+        }
+        assert!(fragment_options(true,None,Some("1001")).is_err());
+        let c = fragment_options(true,Some("4"),Some("0")).unwrap();
+        assert_eq!((c.size_min,c.size_max,c.delay_max_ms),(4,4,0));
+    }
+}
