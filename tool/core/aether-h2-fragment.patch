diff --git a/aether/src/consts.rs b/aether/src/consts.rs
index 13bfc0f..2c054bd 100644
--- a/aether/src/consts.rs
+++ b/aether/src/consts.rs
@@ -3,6 +3,43 @@ pub const API_VERSION: &str = "v0a4471";
 
 pub const CONNECT_SNI: &str = "consumer-masque.cloudflareclient.com";
 pub const L4_CONNECT_SNI: &str = "consumer-masque-proxy.cloudflareclient.com";
+
+/// The name the MASQUE handshakes put in the ClientHello, which [CONNECT_SNI]
+/// unless a job asked for another one.
+///
+/// Iran's firewall resets a whole ClientHello whose SNI ends in
+/// cloudflareclient.com, which is exactly what [CONNECT_SNI] is. Upstream's
+/// answer is `--fragment`, splitting the hello so the name crosses a packet
+/// boundary. This is the other answer: send a name the filter has no reason to
+/// match, and leave the hello in one piece. Measured in the field on networks
+/// where the fragmenting answer had stopped working.
+///
+/// A global rather than a field on the job, because the name is read in nine
+/// places across the scan, the probe and both tunnel paths, and threading it
+/// through all of them would be a far larger change to carry against upstream.
+/// Set once when a job starts, read for the length of it.
+static MASQUE_SNI: std::sync::RwLock<Option<String>> = std::sync::RwLock::new(None);
+
+/// Point the MASQUE handshakes at [sni]. None, or blank, restores the built-in
+/// name. Jobs set this as they start, so the caller can try one name and then
+/// fall back to the other.
+pub fn set_masque_sni(sni: Option<String>) {
+    let want = sni
+        .map(|s| s.trim().to_string())
+        .filter(|s| !s.is_empty());
+    if let Ok(mut slot) = MASQUE_SNI.write() {
+        *slot = want;
+    }
+}
+
+/// The name in force now.
+pub fn connect_sni() -> String {
+    MASQUE_SNI
+        .read()
+        .ok()
+        .and_then(|slot| slot.clone())
+        .unwrap_or_else(|| CONNECT_SNI.to_string())
+}
 pub const CONNECT_URI: &str = "https://cloudflareaccess.com";
 
 pub const ECH_PUBLIC_NAME: &str = "cloudflare-ech.com";
