@@ -0,0 +1,19 @@
+package main
+
+import (
+	"fmt"
+	"os"
+
+	"github.com/sagernet/sing-box/experimental/libbox"
+)
+
+const probe = `{"endpoints":[{"type":"awg","tag":"nova-awg-probe","private_key":"AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=","address":["10.0.0.2/32"],"mtu":1408,"jc":4,"jmin":40,"jmax":70,"s1":15,"s2":20,"h1":"1","h2":"2","h3":"3","h4":"4","i1":"<b 0xaa>","peers":[{"public_key":"AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=","address":"127.0.0.1","port":51820,"allowed_ips":["0.0.0.0/0"],"persistent_keepalive_interval":25}]}]}`
+
+func main() {
+	err := libbox.CheckConfig(probe)
+	if err != nil {
+		fmt.Println("CheckConfig error:", err)
+		os.Exit(1)
+	}
+	fmt.Println("CheckConfig ok")
+}
